# build output
dist/
# generated types
.astro/
# wrangler pages dev local state (KV/Vectorize sim, sourcemaps)
.wrangler/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# VSCode settings
.vscode/

# npm lockfile (using pnpm)
package-lock.json

# temp scripts
__pycache__/

# wechat-inbox content staging (private, never commit)
source/*/
!source/README.md
!source/.gitkeep

# Claude Code local skill mirror — .agents/skills/ is the tracked source.
# 由 scripts/bootstrap-machine.sh 从 .agents/skills/ 重新生成，不要手改这里面的东西。
.claude/

# sync-ledger.cjs import 的中转目录，导完即删
.agents/skills/blog-publisher/.ledger-inbox/

# run logs (already-tracked logs stay tracked)
*.log

# forage 的 SQLite 决策库。不入库是故意的：二进制、每晚全量重写、没法 review，
# 两台机器都写还会冲突。丢了也不致命 —— store.py sync 每晚会从
# src/content/blog/ 重新播种 seen 表，对「已发过的文章」的查重照样有效，
# 丢的只是评审台里 write/skip 的历史标记。
radar/

# Playwright MCP debug output (console logs / page snapshots from browser automation runs)
.playwright-mcp/

# regenerable index-build artifacts (large, derived from src/content/blog — not source)
semantic-search/eval/vectorize-index-plan.json
semantic-search/eval/.vectorize-vectors-cache.json
semantic-search/eval/manifest-plan.json
semantic-search/eval/.manifest-kv-namespace-id
semantic-search/eval/incremental-index-plan.json
semantic-search/eval/reconcile-plan.json

# 第三方 skill 的本地副本：20MB，自带 LICENSE，属于外部项目，不进本仓库
# （实际被 Claude Code 加载的是 .claude/skills/ 那份镜像，本身也未跟踪）
.agents/skills/lieflat-charts/
