---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<h2><a href="/">🍄 {SITE_TITLE}</a></h2>
		<div class="internal-links">
			<HeaderLink href="/search/" title="Search" aria-label="Search">🔍</HeaderLink>
			<HeaderLink href="/my/" title="My" aria-label="My">🧑‍💻</HeaderLink>
			<HeaderLink href="/video/" title="Video" aria-label="Video">🎬</HeaderLink>
			<a href="https://idoris.ai" target="_blank" rel="noopener" class="ext-link">iDoris.AI</a>
			<a href="https://aastar.io/" target="_blank" rel="noopener" class="ext-link">AAStar</a>
			<!-- 页内锚点滚动到 Footer 的真实订阅表单，不弹窗、不跳转到 listmonk -->
			<a href="#subscribe" class="rss-icon" title="Subscribe" aria-label="Subscribe">📮</a>
		</div>
		<div class="right-controls">
			<button id="theme-toggle" class="theme-toggle" type="button" aria-label="Toggle dark/light mode" title="Toggle dark/light mode" aria-pressed="false">
				<svg class="icon-moon" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
				</svg>
				<svg class="icon-sun" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<circle cx="12" cy="12" r="4"></circle>
					<path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
				</svg>
			</button>
		</div>
	</nav>
</header>
<script>
	const STORAGE_KEY = 'theme';
	const toggle = document.getElementById('theme-toggle');
	// BaseHead 的早期脚本可能已经在这段脚本跑之前就把 data-theme 设成了 dark
	// （读 localStorage），这里要跟当前真实状态同步，不能假设初始一定是 false
	toggle?.setAttribute('aria-pressed', String(document.documentElement.dataset.theme === 'dark'));
	toggle?.addEventListener('click', () => {
		const goingDark = document.documentElement.dataset.theme !== 'dark';
		if (goingDark) {
			document.documentElement.dataset.theme = 'dark';
		} else {
			delete document.documentElement.dataset.theme;
		}
		toggle.setAttribute('aria-pressed', String(goingDark));
		try {
			localStorage.setItem(STORAGE_KEY, goingDark ? 'dark' : 'light');
		} catch (e) {
			// localStorage 不可用（隐私模式等）：切换本次会话仍然生效，只是刷新后不记住
		}
	});
</script>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: rgb(var(--surface));
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
		transition: background-color 0.2s ease;
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	nav a {
		padding: 1em 0.5em;
		/* --black 是 RGB 三元组，必须包 rgb()；裸 var(--black) 是非法颜色值，
		   整条声明会被丢弃，而 Astro scoped 的 `nav a` 特异性又高过 .ext-link，
		   结果是外链的强调色被这条坏声明连带吃掉。 */
		color: rgb(var(--black));
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	.right-controls {
		display: flex;
		align-items: center;
		gap: 0.75em;
	}
	.theme-toggle {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.2em;
		height: 2.2em;
		padding: 0;
		border: none;
		border-radius: 50%;
		background: transparent;
		color: rgb(var(--gray-dark));
		cursor: pointer;
		transition: background-color 0.15s ease, color 0.2s ease;
	}
	.theme-toggle:hover {
		background: rgba(var(--gray), 15%);
	}
	.theme-toggle .icon-sun {
		display: none;
	}
	:root[data-theme="dark"] .theme-toggle .icon-moon {
		display: none;
	}
	:root[data-theme="dark"] .theme-toggle .icon-sun {
		display: inline-flex;
	}
	.internal-links {
		display: flex;
		align-items: center;
		gap: 0.5em;
	}
	.rss-icon {
		padding: 1em 0.5em;
		font-size: 1.1em;
		text-decoration: none;
		border-bottom: 4px solid transparent;
	}
	.rss-icon:hover {
		border-bottom-color: #ff9500;
	}
	/* 写成 nav a.ext-link 而不是 .ext-link：Astro 给每个选择器都加 scope 属性，
	   `nav a` 编译后是 (0,2,2)，单个 .ext-link 只有 (0,2,0)，会被上面那条
	   color 覆盖掉。 */
	nav a.ext-link {
		font-weight: 600;
		color: var(--accent);
	}
	nav a.ext-link:hover {
		border-bottom-color: var(--accent);
	}
	@media (max-width: 720px) {
		/* let nav links wrap instead of overflowing the viewport
		   (was a single non-wrapping flex row → horizontal page scroll on phones) */
		nav { flex-wrap: wrap; }
		.internal-links { flex-wrap: wrap; gap: 0.1em 0.4em; }
		nav a { padding: 0.5em 0.4em; }
		.rss-icon { padding: 0.5em 0.4em; }
	}
</style>
