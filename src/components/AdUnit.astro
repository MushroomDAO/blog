---
import { AD_CLIENT } from '../consts';

interface Props {
	slot: string;
	layout?: 'in-article' | 'in-feed';
	layoutKey?: string;
}

const { slot, layout, layoutKey } = Astro.props;
---

<ins
	class="adsbygoogle"
	style="display:block"
	data-ad-client={AD_CLIENT}
	data-ad-slot={slot}
	data-ad-format="fluid"
	data-ad-layout={layout === 'in-article' ? 'in-article' : undefined}
	data-ad-layout-key={layout === 'in-feed' ? layoutKey : undefined}
></ins>
<script is:inline>
	(adsbygoogle = window.adsbygoogle || []).push({});
</script>
