---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import data from '../data/blog-analytics.json';

const title = '流量看板 · Website Analytics';
const description = `blog.mushroom.cv 近 30 天访问数据公开看板：浏览量、地域分布、流量来源与热门文章（${data.period.start} ~ ${data.period.end}）。`;

const fmt = (n: number) => n.toLocaleString('en-US');
const pct = (n: number, total: number) => (total ? ((n / total) * 100).toFixed(1) : '0.0');

const refLabels: Record<string, string> = {
	direct: '直接访问 / 书签',
	search: '搜索引擎',
	ecosystem: '站内跳转（mushroom.cv 生态）',
	ai: 'AI 助手引荐',
	other: '社交 / 其他',
};
const refColors: Record<string, string> = {
	direct: 'rgb(var(--gray))',
	search: 'rgb(var(--accent))',
	ecosystem: '#1f8f86',
	ai: '#8a5fd1',
	other: 'rgb(var(--gray-light))',
};
const refTotal = Object.values(data.referers).reduce((a: number, b) => a + (b as number), 0);
const refererRows = (Object.keys(data.referers) as (keyof typeof data.referers)[])
	.map((k) => ({ key: k, label: refLabels[k], color: refColors[k], count: data.referers[k] }))
	.sort((a, b) => b.count - a.count);

const deltaPv = data.last7.pv - data.prior7.pv;
const deltaPct = data.prior7.pv ? ((deltaPv / data.prior7.pv) * 100).toFixed(1) : '0.0';

const maxCountry = Math.max(...data.countries.map((c) => c.pv));
const deviceColors = ['rgb(var(--accent))', '#1f8f86', 'rgb(var(--gray))', '#8a5fd1', '#c9982e', '#5b9bd5'];

// SVG trend chart geometry
const W = 1000, H = 200, padT = 14, padB = 20;
const maxV = Math.max(...data.daily.map((d) => d.pv)) * 1.12;
const n = data.daily.length;
const xAt = (i: number) => (i / (n - 1)) * W;
const yAt = (v: number) => padT + (1 - v / maxV) * (H - padT - padB);
const linePv = data.daily.map((d, i) => `${i === 0 ? 'M' : 'L'} ${xAt(i).toFixed(1)} ${yAt(d.pv).toFixed(1)}`).join(' ');
const lineVi = data.daily.map((d, i) => `${i === 0 ? 'M' : 'L'} ${xAt(i).toFixed(1)} ${yAt(d.visits).toFixed(1)}`).join(' ');
const areaPv = `${linePv} L ${xAt(n - 1).toFixed(1)} ${yAt(0).toFixed(1)} L 0 ${yAt(0).toFixed(1)} Z`;
const labelIdx = [0, Math.round((n - 1) * 0.25), Math.round((n - 1) * 0.5), Math.round((n - 1) * 0.75), n - 1];
---

<html lang="zh-CN">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			main.analytics { width: 100%; max-width: 1080px; }
			.page-head { margin-bottom: 1.5em; }
			.page-head h1 { margin-bottom: 0.2em; }
			.page-head .sub {
				color: rgb(var(--gray));
				font-size: 0.9em;
				display: flex;
				flex-wrap: wrap;
				gap: 0.6em 1.2em;
				align-items: center;
			}
			.src-pill {
				display: inline-flex;
				align-items: center;
				gap: 0.4em;
				background: linear-gradient(var(--gray-gradient)) no-repeat;
				border-radius: 999px;
				padding: 0.25em 0.8em;
				font-size: 0.85em;
			}
			.src-pill .dot { width: 6px; height: 6px; border-radius: 50%; background: #2f8f5b; display: inline-block; }

			.kpis {
				display: grid;
				grid-template-columns: repeat(4, 1fr);
				gap: 1em;
				margin-bottom: 2em;
			}
			.kpi {
				background: linear-gradient(var(--gray-gradient)) no-repeat;
				border-radius: 10px;
				padding: 1em 1.1em;
			}
			.kpi .label { font-size: 0.75em; color: rgb(var(--gray)); text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 0.4em; }
			.kpi .value { font-size: 1.6em; font-weight: 700; font-variant-numeric: tabular-nums; }
			.kpi .delta { margin-top: 0.3em; font-size: 0.8em; }
			.delta.up { color: #2f8f5b; }
			.delta.down { color: #c0392b; }
			.delta.flat { color: rgb(var(--gray)); }

			section.block { margin-bottom: 2em; }
			.section-head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.7em; flex-wrap: wrap; gap: 0.4em; }
			.section-head h2 { font-size: 1.05em; margin: 0; }
			.section-head .note { font-size: 0.78em; color: rgb(var(--gray)); }

			.card {
				background: linear-gradient(var(--gray-gradient)) no-repeat;
				border-radius: 12px;
				padding: 1.2em 1.3em;
			}
			.trend-legend { display: flex; gap: 1.2em; font-size: 0.8em; color: rgb(var(--gray)); margin-bottom: 0.6em; }
			.trend-legend .sw { display: inline-flex; align-items: center; gap: 0.35em; }
			.trend-legend .sw i { width: 10px; height: 10px; border-radius: 2px; display: inline-block; }
			svg.trend { width: 100%; height: 200px; display: block; overflow: visible; }
			.trend-grid line { stroke: rgba(var(--gray), 0.15); stroke-width: 1; }
			.trend-label { font-size: 11px; fill: rgb(var(--gray)); font-family: ui-monospace, "SF Mono", monospace; }

			.cols-2 { display: grid; grid-template-columns: 1.1fr 1fr; gap: 1em; }

			.barlist { display: flex; flex-direction: column; gap: 0.55em; }
			.barlist .row { display: grid; grid-template-columns: 1.6em 6em 1fr 3.6em; align-items: center; gap: 0.6em; font-size: 0.86em; }
			.barlist .flag { font-size: 1.05em; text-align: center; }
			.barlist .name { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
			.barlist .track { background: rgba(var(--gray), 0.15); border-radius: 4px; height: 8px; overflow: hidden; }
			.barlist .fill { height: 100%; border-radius: 4px; background: rgb(var(--accent)); }
			.barlist .pct { text-align: right; color: rgb(var(--gray)); font-variant-numeric: tabular-nums; }

			.chip-row { display: flex; flex-wrap: wrap; gap: 0.5em; }
			.chip {
				display: inline-flex; align-items: center; gap: 0.4em; justify-content: space-between;
				border-radius: 8px; padding: 0.55em 0.75em; font-size: 0.8em;
				background: rgba(var(--gray), 0.08);
				flex: 1 1 auto; min-width: 9em;
			}
			.chip .tag { display: inline-flex; align-items: center; gap: 0.35em; color: rgb(var(--gray-dark)); }
			.chip .tag i { width: 8px; height: 8px; border-radius: 2px; display: inline-block; }
			.chip .num { font-weight: 700; font-variant-numeric: tabular-nums; }

			.callout {
				font-size: 0.82em; color: rgb(var(--gray-dark)); background: rgba(var(--accent), 0.06);
				border-radius: 10px; padding: 0.85em 1em; margin-top: 0.9em;
			}
			.callout b { color: rgb(var(--black)); }

			table.pages { width: 100%; border-collapse: collapse; font-size: 0.86em; }
			table.pages th { text-align: left; font-size: 0.72em; text-transform: uppercase; letter-spacing: 0.05em; color: rgb(var(--gray)); font-weight: 600; padding: 0 0.5em 0.5em; border-bottom: 2px solid rgb(var(--accent)); }
			table.pages td { padding: 0.55em 0.5em; border-bottom: 1px solid rgba(var(--gray), 0.15); vertical-align: middle; }
			table.pages tr:last-child td { border-bottom: none; }
			table.pages td.num { text-align: right; color: rgb(var(--gray)); white-space: nowrap; font-variant-numeric: tabular-nums; }
			table.pages td.rank { color: rgb(var(--gray)); width: 1.8em; }
			table.pages td.title a { color: rgb(var(--gray-dark)); text-decoration: none; border-bottom: 1px dotted rgb(var(--gray)); }
			table.pages td.title a:hover { color: rgb(var(--accent)); border-color: rgb(var(--accent)); }
			.path { color: rgb(var(--gray)); font-size: 0.76em; display: block; margin-top: 0.1em; }
			.table-scroll { overflow-x: auto; }

			.stack-cols { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.2em; }
			.mini-bars { display: flex; flex-direction: column; gap: 0.45em; }
			.mini-bars .row { display: grid; grid-template-columns: 6em 1fr 2.8em; align-items: center; gap: 0.5em; font-size: 0.82em; }
			.mini-bars .name { color: rgb(var(--gray-dark)); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
			.mini-bars .track { background: rgba(var(--gray), 0.15); border-radius: 4px; height: 7px; overflow: hidden; }
			.mini-bars .fill { height: 100%; border-radius: 4px; }
			.mini-bars .num { text-align: right; color: rgb(var(--gray)); font-variant-numeric: tabular-nums; }

			.foot-note { font-size: 0.78em; color: rgb(var(--gray)); margin-top: 2.5em; padding-top: 1em; border-top: 1px solid rgba(var(--gray), 0.2); }

			@media (max-width: 768px) {
				.kpis { grid-template-columns: repeat(2, 1fr); }
				.cols-2 { grid-template-columns: 1fr; }
				.stack-cols { grid-template-columns: 1fr; }
				.barlist .row { grid-template-columns: 1.3em 4.5em 1fr 2.8em; }
			}
		</style>
	</head>
	<body>
		<Header />
		<main class="analytics">
			<div class="page-head">
				<h1>📊 流量看板 · Website Analytics</h1>
				<div class="sub">
					<span class="src-pill"><span class="dot"></span>Cloudflare Web Analytics（RUM，非 Cookie）</span>
					<span>{data.period.start} ~ {data.period.end} · 近 30 天，每 2 天自动更新</span>
				</div>
			</div>

			<section class="kpis">
				<div class="kpi">
					<div class="label">总浏览量 Pageviews</div>
					<div class="value">{fmt(data.totals.pageviews)}</div>
					<div class="delta flat">已剔除 {data.totals.bots} 次机器人抓取</div>
				</div>
				<div class="kpi">
					<div class="label">独立访问 Visits</div>
					<div class="value">{fmt(data.totals.visits)}</div>
					<div class="delta flat">约 {(data.totals.pageviews / data.totals.visits).toFixed(2)} 页 / 次访问</div>
				</div>
				<div class="kpi">
					<div class="label">近 7 天浏览量</div>
					<div class="value">{fmt(data.last7.pv)}</div>
					<div class={`delta ${deltaPv > 0 ? 'up' : deltaPv < 0 ? 'down' : 'flat'}`}>
						{deltaPv > 0 ? '▲' : deltaPv < 0 ? '▼' : '–'} {deltaPct}%（{fmt(data.prior7.pv)} → {fmt(data.last7.pv)}）
					</div>
				</div>
				<div class="kpi">
					<div class="label">覆盖地区</div>
					<div class="value">{data.countries.length}+</div>
					<div class="delta flat">个国家/地区，30 天内</div>
				</div>
			</section>

			<section class="block">
				<div class="section-head">
					<h2>每日浏览量趋势</h2>
					<span class="note">最近一日为当天未完结数据</span>
				</div>
				<div class="card">
					<div class="trend-legend">
						<span class="sw"><i style="background:rgb(var(--accent))"></i>浏览量 Pageviews</span>
						<span class="sw"><i style="background:#1f8f86"></i>独立访问 Visits</span>
					</div>
					<svg class="trend" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none">
						<g class="trend-grid">
							{[0, 1, 2, 3, 4].map((t) => (
								<line x1="0" y1={padT + (t / 4) * (H - padT - padB)} x2={W} y2={padT + (t / 4) * (H - padT - padB)} />
							))}
						</g>
						<defs>
							<linearGradient id="areaFill" x1="0" y1="0" x2="0" y2="1">
								<stop offset="0%" stop-color="rgb(var(--accent))" stop-opacity="0.3" />
								<stop offset="100%" stop-color="rgb(var(--accent))" stop-opacity="0" />
							</linearGradient>
						</defs>
						<path d={areaPv} fill="url(#areaFill)" stroke="none" />
						<path d={lineVi} fill="none" stroke="#1f8f86" stroke-width="1.6" stroke-opacity="0.85" />
						<path d={linePv} fill="none" stroke="rgb(var(--accent))" stroke-width="2.25" />
						<circle cx={xAt(n - 1)} cy={yAt(data.daily[n - 1].pv)} r="4.5" fill="rgb(var(--accent))" stroke="#fff" stroke-width="2" />
						{labelIdx.map((i) => (
							<text
								x={xAt(i)}
								y={H - 2}
								class="trend-label"
								text-anchor={i === 0 ? 'start' : i === n - 1 ? 'end' : 'middle'}
							>
								{data.daily[i].date}
							</text>
						))}
					</svg>
				</div>
			</section>

			<section class="block">
				<div class="cols-2">
					<div class="card">
						<div class="section-head">
							<h2>地域分布 Top 12</h2>
							<span class="note">按浏览量占比</span>
						</div>
						<div class="barlist">
							{data.countries.map((c) => (
								<div class="row">
									<span class="flag">{c.flag}</span>
									<span class="name">{c.name}</span>
									<span class="track"><span class="fill" style={`width:${(c.pv / maxCountry) * 100}%`} /></span>
									<span class="pct">{pct(c.pv, data.countryTotal)}%</span>
								</div>
							))}
						</div>
						<div class="callout">
							<b>解读提醒</b>：博主本人常驻东南亚，占比靠前的地区可能混入了作者写作/调试时的自访问，实际读者地域分布会比图上更分散。
						</div>
					</div>

					<div class="card">
						<div class="section-head">
							<h2>流量来源</h2>
							<span class="note">按 referrer 归类</span>
						</div>
						<div class="chip-row">
							{refererRows.map((r) => (
								<div class="chip">
									<span class="tag"><i style={`background:${r.color}`} />{r.label}</span>
									<span class="num">{pct(r.count, refTotal)}%</span>
								</div>
							))}
						</div>
						<div class="callout">
							<b>怎么读</b>：「直接访问」占大头通常意味着读者是收藏/书签，或从公众号、私聊分享链接点进来的——这类来源 Cloudflare 拿不到具体出处，都会归到这一类。
						</div>
					</div>
				</div>
			</section>

			<section class="block">
				<div class="section-head">
					<h2>最受欢迎的页面 Top 15</h2>
					<span class="note">首页除外为文章浏览量</span>
				</div>
				<div class="card table-scroll">
					<table class="pages">
						<thead>
							<tr><th class="rank">#</th><th>文章</th><th class="num">浏览量</th><th class="num">独立访问</th></tr>
						</thead>
						<tbody>
							{data.pages.map((p, i) => (
								<tr>
									<td class="rank">{i + 1}</td>
									<td class="title">
										<a href={p.path} target="_blank" rel="noopener">{p.title}</a>
										<span class="path">{p.path}</span>
									</td>
									<td class="num">{fmt(p.pv)}</td>
									<td class="num">{fmt(p.visits)}</td>
								</tr>
							))}
						</tbody>
					</table>
				</div>
			</section>

			<section class="block">
				<div class="section-head">
					<h2>设备 / 系统 / 浏览器</h2>
					<span class="note">30 天汇总</span>
				</div>
				<div class="card stack-cols">
					{[
						{ label: '设备类型', rows: data.devices },
						{ label: '操作系统', rows: data.os },
						{ label: '浏览器', rows: data.browsers },
					].map((group) => {
						const max = Math.max(...group.rows.map((r) => r.count));
						return (
							<div>
								<div class="note" style="margin-bottom:0.5em;">{group.label}</div>
								<div class="mini-bars">
									{group.rows.map((r, i) => (
										<div class="row">
											<span class="name">{r.label}</span>
											<span class="track"><span class="fill" style={`width:${(r.count / max) * 100}%;background:${deviceColors[i % deviceColors.length]}`} /></span>
											<span class="num">{fmt(r.count)}</span>
										</div>
									))}
								</div>
							</div>
						);
					})}
				</div>
			</section>

			<p class="foot-note">
				数据来自 Cloudflare GraphQL Analytics API（Web Analytics / RUM 数据集），不使用 Cookie、不采集个人身份信息。
				页面每次构建时读取最新数据快照，自动更新任务每 2 天运行一次。
				生成时间：{new Date(data.generatedAt).toISOString().slice(0, 16).replace('T', ' ')} UTC
			</p>
		</main>
		<Footer />
	</body>
</html>
