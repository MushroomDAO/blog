---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import snapshot from '../data/blog-analytics.json';
import {
	STRINGS,
	renderKpis,
	renderTrend,
	renderCountries,
	renderReferers,
	renderPages,
	renderStacks,
	renderSearch,
} from '../lib/analytics-render.js';

// 默认英文：首屏 HTML 直接就是英文，不靠 JS 兜——JS 被禁时页面依然完整可读，
// 也避免中文闪一下再跳成英文。中文由右上角开关在客户端切换。
const LANG = 'en';
const t = STRINGS[LANG];

// 构建期快照没有 live 标记，实时接口返回的数据才有
const data = { ...snapshot, live: false };

const title = `${t.pageTitle} · 流量看板`;
const description = t.pageDesc(data.period.start, data.period.end);

// 边缘运行时读不到 src/content/blog/*.md，实时接口回不出文章标题。
// 把标题表烤进页面，前端拿到实时数据后按 path 合并回去。
const titleMap: Record<string, { title: string; titleEn: string }> = {};
for (const p of data.pages) {
	titleMap[p.path] = { title: p.title, titleEn: (p as any).titleEn ?? p.title };
}
---

<html lang={t.htmlLang}>
	<head>
		<BaseHead title={title} description={description} />
		<style>
			main.analytics { width: 100%; max-width: 1080px; }
			.page-head { margin-bottom: 1.5em; }
			.page-head .title-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 1em; }
			.page-head h1 { margin-bottom: 0.2em; }
			.page-head .sub {
				color: rgb(var(--gray));
				font-size: 0.9em;
				display: flex;
				flex-wrap: wrap;
				gap: 0.6em 1.2em;
				align-items: center;
			}
			.src-pill {
				display: inline-flex;
				align-items: center;
				gap: 0.4em;
				background: linear-gradient(var(--gray-gradient)) no-repeat;
				border-radius: 999px;
				padding: 0.25em 0.8em;
				font-size: 0.85em;
			}
			.src-pill .dot { width: 6px; height: 6px; border-radius: 50%; background: #2f8f5b; display: inline-block; }
			.src-pill .dot.live { animation: pulse 2s ease-in-out infinite; }
			@keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.35; } }

			.lang-toggle {
				flex: none;
				margin-top: 0.35em;
				font: inherit;
				font-size: 0.8em;
				font-weight: 600;
				letter-spacing: 0.02em;
				color: rgb(var(--gray-dark));
				background: linear-gradient(var(--gray-gradient)) no-repeat;
				border: 1px solid rgba(var(--gray), 0.3);
				border-radius: 999px;
				padding: 0.4em 1em;
				cursor: pointer;
				transition: color 0.15s, border-color 0.15s;
			}
			.lang-toggle:hover { color: rgb(var(--accent)); border-color: rgb(var(--accent)); }
			.lang-toggle:focus-visible { outline: 2px solid rgb(var(--accent)); outline-offset: 2px; }

			.kpis {
				display: grid;
				grid-template-columns: repeat(4, 1fr);
				gap: 1em;
				margin-bottom: 2em;
			}
			.kpi {
				background: linear-gradient(var(--gray-gradient)) no-repeat;
				border-radius: 10px;
				padding: 1em 1.1em;
			}
			.kpi .label { font-size: 0.75em; color: rgb(var(--gray)); text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 0.4em; }
			.kpi .value { font-size: 1.6em; font-weight: 700; font-variant-numeric: tabular-nums; }
			.kpi .delta { margin-top: 0.3em; font-size: 0.8em; }
			.delta.up { color: #2f8f5b; }
			.delta.down { color: #c0392b; }
			.delta.flat { color: rgb(var(--gray)); }

			section.block { margin-bottom: 2em; }
			.section-head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.7em; flex-wrap: wrap; gap: 0.4em; }
			.section-head h2 { font-size: 1.05em; margin: 0; }
			.section-head .note { font-size: 0.78em; color: rgb(var(--gray)); }

			.card {
				background: linear-gradient(var(--gray-gradient)) no-repeat;
				border-radius: 12px;
				padding: 1.2em 1.3em;
			}
			.trend-legend { display: flex; gap: 1.2em; font-size: 0.8em; color: rgb(var(--gray)); margin-bottom: 0.6em; }
			.trend-legend .sw { display: inline-flex; align-items: center; gap: 0.35em; }
			.trend-legend .sw i { width: 10px; height: 10px; border-radius: 2px; display: inline-block; }
			svg.trend { width: 100%; height: 200px; display: block; overflow: visible; }
			.trend-grid line { stroke: rgba(var(--gray), 0.15); stroke-width: 1; }
			.trend-label { font-size: 11px; fill: rgb(var(--gray)); font-family: ui-monospace, "SF Mono", monospace; }

			.cols-2 { display: grid; grid-template-columns: 1.1fr 1fr; gap: 1em; }

			.barlist { display: flex; flex-direction: column; gap: 0.55em; }
			.barlist .row { display: grid; grid-template-columns: 1.6em 8em 1fr 3.6em; align-items: center; gap: 0.6em; font-size: 0.86em; }
			.barlist .flag { font-size: 1.05em; text-align: center; }
			.barlist .name { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
			.barlist .track { background: rgba(var(--gray), 0.15); border-radius: 4px; height: 8px; overflow: hidden; }
			.barlist .fill { height: 100%; border-radius: 4px; background: rgb(var(--accent)); }
			.barlist .pct { text-align: right; color: rgb(var(--gray)); font-variant-numeric: tabular-nums; }

			.chip-row { display: flex; flex-wrap: wrap; gap: 0.5em; }
			.chip {
				display: inline-flex; align-items: center; gap: 0.4em; justify-content: space-between;
				border-radius: 8px; padding: 0.55em 0.75em; font-size: 0.8em;
				background: rgba(var(--gray), 0.08);
				flex: 1 1 auto; min-width: 9em;
			}
			.chip .tag { display: inline-flex; align-items: center; gap: 0.35em; color: rgb(var(--gray-dark)); }
			.chip .tag i { width: 8px; height: 8px; border-radius: 2px; display: inline-block; }
			.chip .num { font-weight: 700; font-variant-numeric: tabular-nums; }

			.callout {
				font-size: 0.82em; color: rgb(var(--gray-dark)); background: rgba(var(--accent), 0.06);
				border-radius: 10px; padding: 0.85em 1em; margin-top: 0.9em;
			}
			.callout b { color: rgb(var(--black)); }

			table.pages { width: 100%; border-collapse: collapse; font-size: 0.86em; }
			table.pages th { text-align: left; font-size: 0.72em; text-transform: uppercase; letter-spacing: 0.05em; color: rgb(var(--gray)); font-weight: 600; padding: 0 0.5em 0.5em; border-bottom: 2px solid rgb(var(--accent)); }
			table.pages td { padding: 0.55em 0.5em; border-bottom: 1px solid rgba(var(--gray), 0.15); vertical-align: middle; }
			table.pages tr:last-child td { border-bottom: none; }
			table.pages td.num { text-align: right; color: rgb(var(--gray)); white-space: nowrap; font-variant-numeric: tabular-nums; }
			table.pages td.rank { color: rgb(var(--gray)); width: 1.8em; }
			table.pages td.title a { color: rgb(var(--gray-dark)); text-decoration: none; border-bottom: 1px dotted rgb(var(--gray)); }
			table.pages td.title a:hover { color: rgb(var(--accent)); border-color: rgb(var(--accent)); }
			.path { color: rgb(var(--gray)); font-size: 0.76em; display: block; margin-top: 0.1em; }
			.table-scroll { overflow-x: auto; }

			.stack-cols { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.2em; }
			.mini-bars { display: flex; flex-direction: column; gap: 0.45em; }
			.mini-bars .row { display: grid; grid-template-columns: 6em 1fr 2.8em; align-items: center; gap: 0.5em; font-size: 0.82em; }
			.mini-bars .name { color: rgb(var(--gray-dark)); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
			.mini-bars .track { background: rgba(var(--gray), 0.15); border-radius: 4px; height: 7px; overflow: hidden; }
			.mini-bars .fill { height: 100%; border-radius: 4px; }
			.mini-bars .num { text-align: right; color: rgb(var(--gray)); font-variant-numeric: tabular-nums; }

			.foot-note { font-size: 0.78em; color: rgb(var(--gray)); margin-top: 2.5em; padding-top: 1em; border-top: 1px solid rgba(var(--gray), 0.2); }

			@media (max-width: 768px) {
				.kpis { grid-template-columns: repeat(2, 1fr); }
				.cols-2 { grid-template-columns: 1fr; }
				.stack-cols { grid-template-columns: 1fr; }
				.barlist .row { grid-template-columns: 1.3em 5.5em 1fr 2.8em; }
			}
		</style>
	</head>
	<body>
		<Header />
		<main class="analytics" id="analytics-root">
			<div class="page-head">
				<div class="title-row">
					<h1 data-a="title">📊 {t.pageTitle}</h1>
					<button type="button" class="lang-toggle" data-a="lang" aria-label={t.langButtonLabel}>
						{t.langButton}
					</button>
				</div>
				<div class="sub">
					<span class="src-pill"><span class="dot" data-a="dot"></span><span data-a="source">{t.source}</span></span>
					<span data-a="period">{data.period.start} ~ {data.period.end} · {t.periodSuffix} · {t.liveStale}</span>
				</div>
			</div>

			<section class="kpis" data-a="kpis" set:html={renderKpis(data, LANG)} />

			<section class="block">
				<div class="section-head">
					<h2 data-a="trend-head">{t.trendHead}</h2>
					<span class="note" data-a="trend-note">{t.trendNote}</span>
				</div>
				<div class="card">
					<div class="trend-legend">
						<span class="sw"><i style="background:rgb(var(--accent))"></i><span data-a="legend-pv">{t.legendPv}</span></span>
						<span class="sw"><i style="background:#1f8f86"></i><span data-a="legend-visits">{t.legendVisits}</span></span>
					</div>
					<svg class="trend" viewBox="0 0 1000 200" preserveAspectRatio="none" data-a="trend" set:html={renderTrend(data)} />
				</div>
			</section>

			<section class="block">
				<div class="cols-2">
					<div class="card">
						<div class="section-head">
							<h2 data-a="geo-head">{t.geoHead}</h2>
							<span class="note" data-a="geo-note">{t.geoNote}</span>
						</div>
						<div class="barlist" data-a="countries" set:html={renderCountries(data, LANG)} />
						<div class="callout" data-a="geo-callout" set:html={t.geoCallout} />
					</div>

					<div class="card">
						<div class="section-head">
							<h2 data-a="ref-head">{t.refHead}</h2>
							<span class="note" data-a="ref-note">{t.refNote}</span>
						</div>
						<div class="chip-row" data-a="referers" set:html={renderReferers(data, LANG)} />
						<div class="callout" data-a="ref-callout" set:html={t.refCallout} />
					</div>
				</div>
			</section>

			<section class="block">
				<div class="section-head">
					<h2 data-a="pages-head">{t.pagesHead}</h2>
					<span class="note" data-a="pages-note">{t.pagesNote}</span>
				</div>
				<div class="card table-scroll">
					<table class="pages">
						<thead>
							<tr>
								<th class="rank" data-a="col-rank">{t.colRank}</th>
								<th data-a="col-page">{t.colPage}</th>
								<th class="num" data-a="col-pv">{t.colPv}</th>
								<th class="num" data-a="col-visits">{t.colVisits}</th>
							</tr>
						</thead>
						<tbody data-a="pages" set:html={renderPages(data, LANG)} />
					</table>
				</div>
			</section>

			<section class="block">
				<div class="section-head">
					<h2 data-a="stack-head">{t.stackHead}</h2>
					<span class="note" data-a="stack-note">{t.stackNote}</span>
				</div>
				<div class="card stack-cols" data-a="stacks" set:html={renderStacks(data, LANG)} />
			</section>

			<section class="block">
				<div class="section-head">
					<h2 data-a="search-head">{t.searchHead}</h2>
					<span class="note" data-a="search-note">{t.searchNote}</span>
				</div>
				<div class="card" data-a="search" set:html={renderSearch(data, LANG)} />
			</section>

			<p class="foot-note" data-a="footer">{t.footer(new Date(data.generatedAt).toISOString().slice(0, 16).replace('T', ' '), false)}</p>
		</main>
		<Footer />

		<script
			is:inline
			set:html={`window.__ANALYTICS_TITLES__ = ${JSON.stringify(titleMap).replace(/</g, '\\u003c')};`}
		/>

		<script>
			import snapshot from '../data/blog-analytics.json';
			import { paint, mergeTitles } from '../lib/analytics-render.js';

			const root = document.getElementById('analytics-root');
			const STORAGE_KEY = 'mycelium:analytics:lang';

			// 默认英文；只有用户显式切换过才记住中文
			let lang = localStorage.getItem(STORAGE_KEY) === 'zh' ? 'zh' : 'en';
			let data = { ...snapshot, live: false };

			const titleMap = window.__ANALYTICS_TITLES__ || {};

			function render() {
				paint(root, data, lang);
				const dot = root.querySelector('[data-a="dot"]');
				if (dot) dot.classList.toggle('live', !!data.live);
			}

			root.querySelector('[data-a="lang"]')?.addEventListener('click', () => {
				lang = lang === 'en' ? 'zh' : 'en';
				localStorage.setItem(STORAGE_KEY, lang);
				render();
			});

			// 服务端已经渲染好英文，语言是英文时不必重画一遍
			if (lang !== 'en') render();

			// 实时数据：接口失败就静默保留构建快照，页面不退化
			fetch('/api/analytics.json', { headers: { accept: 'application/json' } })
				.then((r) => (r.ok ? r.json() : Promise.reject(new Error(`HTTP ${r.status}`))))
				.then((live) => {
					if (!live || !Array.isArray(live.daily) || !live.daily.length) return;
					// mergeTitles 整体替换 data，search 这一节独立于这次公开看板的取数
					// （见下面单独的 fetch），这里先保留上一轮已经拿到的 data.search，
					// 不要因为公开看板刷新一次就把它冲掉。
					data = { ...mergeTitles(live, titleMap), search: data.search };
					render();
				})
				.catch(() => {
					/* 保持构建期快照 */
				});

			// 搜索使用统计：独立的登录门禁端点（见 functions/api/search-analytics.json.js
			// 文件头注释——刻意不跟上面公开看板共用同一次取数/缓存，避免登录用户才能看的
			// 数据经由公开缓存泄露给所有访客）。未登录会拿到 401，页面照实显示"登录后可见"，
			// 不是页面级错误。
			fetch('/api/search-analytics.json', { headers: { accept: 'application/json' } })
				.then(async (r) => {
					if (r.status === 401) return { error: 'unauthorized' };
					if (!r.ok) return { error: 'upstream_http', status: r.status };
					return r.json();
				})
				.then((search) => {
					data = { ...data, search };
					render();
				})
				.catch(() => {
					/* 保持"暂无数据"兜底文案，不影响页面其余部分 */
				});
		</script>
	</body>
</html>
