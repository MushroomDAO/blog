---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
---

<html lang="zh-CN">
	<head>
		<BaseHead
			title="搜索"
			titleEn="Search"
			description="搜索 Mycelium Protocol Blog 的全部文章"
			descriptionEn="Search all articles on the Mycelium Protocol Blog"
		/>
		<style>
			/* Pagefind 默认 UI 自带一套 CSS 变量，跟着站点的亮/暗主题变量走，
			   不然切到暗色模式时搜索框还是它自己写死的浅色样式 */
			#search {
				--pagefind-ui-primary: rgb(var(--gray-dark));
				--pagefind-ui-text: rgb(var(--gray-dark));
				--pagefind-ui-background: rgb(var(--surface));
				--pagefind-ui-border: rgb(var(--gray-light));
			}
			main.search-page {
				width: 100%;
				max-width: 800px;
				margin: 0 auto;
				padding: 2em 1em;
			}
			.search-page h1 {
				margin-bottom: 0.8em;
			}
			.search-page .fallback-note {
				display: none;
				color: rgb(var(--gray));
				font-size: 0.9em;
				background: rgba(var(--gray), 0.08);
				border-radius: 8px;
				padding: 0.8em 1em;
				margin-top: 1em;
			}
			.search-page .fallback-note.visible {
				display: block;
			}
			.semantic-search-section {
				margin-top: 2.5em;
				padding-top: 1.5em;
				border-top: 1px solid rgb(var(--gray-light));
			}
			.semantic-search-section h2 {
				font-size: 1.1em;
				margin-bottom: 0.4em;
			}
			.semantic-search-hint {
				color: rgb(var(--gray));
				font-size: 0.9em;
				margin-bottom: 1em;
			}
			.semantic-login-form {
				display: flex;
				gap: 0.5em;
				max-width: 360px;
			}
			.semantic-login-form input[type='password'] {
				flex: 1;
				min-width: 0;
				padding: 0.55em 0.8em;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 8px;
				font-size: 0.95em;
				background: rgb(var(--surface));
				color: rgb(var(--gray-dark));
			}
			.semantic-login-form button {
				flex-shrink: 0;
				padding: 0.55em 1.2em;
				background: rgb(var(--accent));
				color: #fff;
				border: none;
				border-radius: 8px;
				font-weight: 600;
				cursor: pointer;
			}
			.semantic-login-form button:disabled {
				opacity: 0.6;
				cursor: default;
			}
			.semantic-login-status {
				margin-top: 0.6em;
				font-size: 0.85em;
				min-height: 1.2em;
			}
			.semantic-login-status.is-error {
				color: #c0392b;
			}
			.semantic-login-status.is-success {
				color: #1a7f37;
			}
			.semantic-search-widget {
				margin-top: 1em;
			}
			.semantic-search-widget input[type='text'] {
				width: 100%;
				max-width: 480px;
				padding: 0.55em 0.8em;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 8px;
				font-size: 0.95em;
				background: rgb(var(--surface));
				color: rgb(var(--gray-dark));
			}
			.semantic-results {
				list-style: none;
				margin: 1em 0 0;
				padding: 0;
			}
			.semantic-result-item {
				padding: 0.8em 0;
				border-bottom: 1px solid rgb(var(--gray-light));
			}
			.semantic-result-item a {
				font-weight: 600;
				color: rgb(var(--accent));
			}
			.semantic-result-item .semantic-result-excerpt {
				color: rgb(var(--gray));
				font-size: 0.9em;
				margin-top: 0.3em;
			}
			.semantic-empty-note {
				color: rgb(var(--gray));
				font-size: 0.9em;
				margin-top: 1em;
			}
		</style>
	</head>
	<body>
		<Header />
		<main class="search-page">
			<h1>🔍 搜索文章 / Search Articles</h1>
			<div id="search"></div>
			<p class="fallback-note" id="search-fallback-note">
				搜索索引加载失败，可能是本地开发环境（<code>pnpm dev</code>）还没有生成索引——先跑一次
				<code>pnpm build</code> 再用 <code>pnpm preview</code> 预览。
			</p>

			<section class="semantic-search-section" id="semantic-search-section">
				<h2>🔐 语义检索</h2>
				<p class="semantic-search-hint" id="semantic-search-hint">
					在关键词之外，理解自然语言诉求的检索能力。需要登录使用。
				</p>
				<form class="semantic-login-form" id="semantic-login-form">
					<input
						type="password"
						id="semantic-login-password"
						placeholder="密码"
						autocomplete="current-password"
						required
					/>
					<button type="submit" id="semantic-login-submit">登录</button>
				</form>
				<p class="semantic-login-status" id="semantic-login-status"></p>

				<div class="semantic-search-widget" id="semantic-search-widget" style="display: none;">
					<input
						type="text"
						id="semantic-search-input"
						placeholder="用一句话描述你想找的内容…"
						autocomplete="off"
					/>
					<ul class="semantic-results" id="semantic-results"></ul>
					<p class="semantic-empty-note" id="semantic-empty-note" style="display: none;">
						没有找到相关文章，换个说法试试？
					</p>
				</div>
			</section>
		</main>
		<Footer />

		<link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
		<script is:inline src="/pagefind/pagefind-ui.js"></script>
		<script is:inline>
			window.addEventListener('DOMContentLoaded', () => {
				if (typeof PagefindUI === 'undefined') {
					document.getElementById('search-fallback-note')?.classList.add('visible');
					return;
				}
				new PagefindUI({ element: '#search', showSubResults: true, showImages: false });
			});
		</script>

		<script is:inline>
			// is:inline：这段脚本用动态 import('/pagefind/pagefind.js') 加载构建后才产出的
			// pagefind 索引模块，那个路径在构建期不存在，Vite 处理的 module script 会在
			// build 时尝试静态解析并失败；is:inline 让 Astro 原样透传这段脚本、不经 Vite
			// 处理，动态 import 交给浏览器在运行时按实际路径解析。
			//
			// 语义检索登录表单。localStorage 的 "searchLoggedIn" 只是给这段 UI 自己看的提示，
			// 不是真正的授权凭证——真正决定 /api/search 放不放行的是 search-auth.js 签发的
			// HttpOnly Cookie（这段 JS 读不到那个 Cookie，也不需要读到）。
			//
			// 修正（对抗式 review 抓到的真实 UX 死角）：这个提示原来只存一个裸的 '1'，永不过期。
			// 真实 Cookie 是 60 天有效期，用户如果手动清过 Cookie（不清 localStorage 是很常见的
			// 不对称操作）或者刚好过了 60 天，页面会一直显示"已登录"、表单被隐藏，但真实会话
			// 早就没了——因为这个提示是 HttpOnly Cookie 读不到时的唯一代理，没有东西能纠正它。
			// 现在存一个带时间戳的记录，比 Cookie 有效期稍短的窗口内才信任这个提示；同时加一个
			// "不是你？重新登录" 的链接，不依赖提示本身准不准，用户随时能手动清掉重新走登录。
			const LOGGED_IN_HINT_KEY = 'searchLoggedIn';
			const HINT_TRUST_WINDOW_MS = 55 * 24 * 60 * 60 * 1000; // 55 天，比 Cookie 的 60 天留一点余量

			function readLoggedInHint() {
				try {
					const raw = localStorage.getItem(LOGGED_IN_HINT_KEY);
					if (!raw) return false;
					const parsed = JSON.parse(raw);
					if (typeof parsed.loggedInAt !== 'number') return false;
					return Date.now() - parsed.loggedInAt < HINT_TRUST_WINDOW_MS;
				} catch {
					return false; // 解析失败/隐私模式禁用 localStorage：当作没登录过，重新走表单
				}
			}

			function writeLoggedInHint() {
				try {
					localStorage.setItem(LOGGED_IN_HINT_KEY, JSON.stringify({ loggedInAt: Date.now() }));
				} catch {
					// 忽略——只影响下次访问要不要重新弹表单，不影响这次登录已经成功
				}
			}

			function clearLoggedInHint() {
				try {
					localStorage.removeItem(LOGGED_IN_HINT_KEY);
				} catch {
					// 忽略
				}
			}

			function renderLoggedInState() {
				const hint = document.getElementById('semantic-search-hint');
				const form = document.getElementById('semantic-login-form');
				const widget = document.getElementById('semantic-search-widget');
				if (form) form.style.display = 'none';
				if (widget) widget.style.display = '';
				if (hint) {
					hint.textContent = '';
					const relogin = document.createElement('a');
					relogin.href = '#';
					// 修正（PR#48 review 指出的措辞问题）：点这个链接只是清掉本地的 UI 提示，
					// 真正的 HttpOnly 会话 Cookie 原封不动、继续有效直到过期——不是登出，
					// 叫"重新登录"会让人误以为原来的会话已经失效了。本项目明确不做服务端
					// 登出接口（见 tasks.md T1.3.6"明确不做"），撤销只能靠轮换
					// BLOG_SEARCH_SESSION_SECRET，所以措辞上如实反映"只是重新输入一遍密码"。
					relogin.textContent = '不是你？重新输入密码';
					relogin.addEventListener('click', (event) => {
						event.preventDefault();
						clearLoggedInHint();
						renderLoggedOutState();
					});
					hint.appendChild(relogin);
				}
			}

			function renderLoggedOutState() {
				const hint = document.getElementById('semantic-search-hint');
				const form = document.getElementById('semantic-login-form');
				const widget = document.getElementById('semantic-search-widget');
				if (hint) hint.textContent = '在关键词之外，理解自然语言诉求的检索能力。需要登录使用。';
				if (form) form.style.display = '';
				if (widget) widget.style.display = 'none';
			}

			// --- T1.3.3：语义检索的混合结果（登录后才会用到）---
			//
			// 融合发生在浏览器端，不在 Worker 里（Pagefind 是纯浏览器端 JS，Worker 调不了）：
			// 见 docs/agent/spec.md §检索融合。这里用 Pagefind 原生 JS API（不是上面挂载的
			// PagefindUI 组件——组件自己管结果渲染，没法把外部的向量结果混进去），跟
			// /api/search 各自的排名做 RRF（Reciprocal Rank Fusion）融合。

			const RRF_K = 60;
			let pagefindModulePromise = null;

			function loadPagefindModule() {
				// 懒加载：只有登录用户真正用语义检索时才拉这个模块，未登录用户的开销不变
				if (!pagefindModulePromise) {
					pagefindModulePromise = import('/pagefind/pagefind.js').catch(() => null);
				}
				return pagefindModulePromise;
			}

			function normalizeUrl(url) {
				if (!url) return '';
				return url.replace(/\/$/, '');
			}

			async function searchPagefindRanked(query) {
				const pagefind = await loadPagefindModule();
				if (!pagefind || typeof pagefind.search !== 'function') return [];
				const search = await pagefind.search(query);
				const withData = await Promise.all(
					(search.results || []).slice(0, 20).map((r) => r.data()),
				);
				return withData.map((data) => ({
					url: normalizeUrl(data.url),
					title: data.meta && data.meta.title,
					excerpt: data.excerpt,
				}));
			}

			async function searchVectorRanked(query) {
				const resp = await fetch('/api/search', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ query }),
				});
				if (resp.status === 401) {
					// 会话真的过期了（不只是本地提示不准）——清掉提示，退回登录表单，
					// 不是静默降级，因为这意味着登录状态本身已经失效
					clearLoggedInHint();
					renderLoggedOutState();
					return null;
				}
				if (!resp.ok) return []; // 429/503/其他：静默降级成"这一路没有结果"，不报错给用户
				const body = await resp.json();
				return (body.results || []).map((r) => ({ url: normalizeUrl(r.url), title: r.title, excerpt: r.excerpt }));
			}

			// RRF：score(doc) = Σ 1/(k + rank_i(doc))，某一路没命中时那一路贡献为 0，
			// 不是"两路都命中才求和"（那等价于取交集，会把某一路独有的召回也丢掉）
			function rrfMerge(pagefindResults, vectorResults) {
				const merged = new Map();
				const addRanked = (list) => {
					list.forEach((item, index) => {
						if (!item.url) return;
						const rank = index + 1;
						const existing = merged.get(item.url) || { url: item.url, title: item.title, excerpt: item.excerpt, score: 0 };
						existing.score += 1 / (RRF_K + rank);
						if (!existing.title) existing.title = item.title;
						if (!existing.excerpt) existing.excerpt = item.excerpt;
						merged.set(item.url, existing);
					});
				};
				addRanked(pagefindResults);
				addRanked(vectorResults);
				return Array.from(merged.values()).sort((a, b) => b.score - a.score);
			}

			function renderCombinedResults(items) {
				const list = document.getElementById('semantic-results');
				const emptyNote = document.getElementById('semantic-empty-note');
				if (!list || !emptyNote) return;
				list.innerHTML = '';
				if (items.length === 0) {
					emptyNote.style.display = '';
					return;
				}
				emptyNote.style.display = 'none';
				for (const item of items) {
					const li = document.createElement('li');
					li.className = 'semantic-result-item';
					const a = document.createElement('a');
					a.href = item.url;
					a.textContent = item.title || item.url;
					li.appendChild(a);
					if (item.excerpt) {
						const p = document.createElement('p');
						p.className = 'semantic-result-excerpt';
						// Pagefind 的 excerpt 自带 <mark> 高亮标记，需要当 HTML 渲染；两路数据都
						// 只来自本站自己的构建产物/API，不是用户输入，不构成 XSS 注入面
						p.innerHTML = item.excerpt;
						li.appendChild(p);
					}
					list.appendChild(li);
				}
			}

			function debounce(fn, delayMs) {
				let timer = null;
				return (...args) => {
					if (timer) clearTimeout(timer);
					timer = setTimeout(() => fn(...args), delayMs);
				};
			}

			async function runCombinedSearch(query) {
				const trimmed = query.trim();
				if (!trimmed) {
					renderCombinedResults([]);
					document.getElementById('semantic-empty-note').style.display = 'none';
					return;
				}
				const [pagefindResults, vectorResults] = await Promise.all([
					searchPagefindRanked(trimmed).catch(() => []),
					searchVectorRanked(trimmed),
				]);
				if (vectorResults === null) return; // 401，已经切回登录表单，不渲染结果
				// "无把握不返回"：两路都没有信号才展示"没有找到"，只要有一路有信号就融合展示
				// （见 spec.md §检索融合第 4 点；两路各自的绝对信号过滤已经在各自源头做过——
				// Pagefind 自己的相关性排序、/api/search 服务端的相似度阈值）
				renderCombinedResults(rrfMerge(pagefindResults, vectorResults));
			}

			function initSemanticSearchWidget() {
				const input = document.getElementById('semantic-search-input');
				if (!input) return;
				input.addEventListener(
					'input',
					debounce((event) => runCombinedSearch(event.target.value), 300),
				);
			}

			function initSemanticLoginForm() {
				if (readLoggedInHint()) {
					renderLoggedInState();
					return;
				}

				const form = document.getElementById('semantic-login-form');
				const passwordInput = document.getElementById('semantic-login-password');
				const submitButton = document.getElementById('semantic-login-submit');
				const status = document.getElementById('semantic-login-status');
				if (!form || !passwordInput || !submitButton || !status) return;

				form.addEventListener('submit', async (event) => {
					event.preventDefault();
					const password = passwordInput.value;
					if (!password) return;

					submitButton.disabled = true;
					status.textContent = '登录中…';
					status.className = 'semantic-login-status';

					try {
						const resp = await fetch('/api/search-auth', {
							method: 'POST',
							headers: { 'Content-Type': 'application/json' },
							body: JSON.stringify({ password }),
						});
						if (resp.ok) {
							writeLoggedInHint();
							status.textContent = '登录成功';
							status.className = 'semantic-login-status is-success';
							renderLoggedInState();
						} else if (resp.status === 429) {
							status.textContent = '尝试次数过多，请稍后再试';
							status.className = 'semantic-login-status is-error';
						} else if (resp.status === 503) {
							// 修正（PR#48 review 指出的真实问题）：503 是服务端配置没弄好
							// （密码/密钥/KV binding 缺一个），不是用户密码打错了——原来一律
							// 显示"密码错误"，会让人对着一个根本没配置好的功能反复猜密码，
							// 而真正的问题在运维那边，用户怎么试都不可能成功
							status.textContent = '服务暂时不可用，请稍后再试';
							status.className = 'semantic-login-status is-error';
						} else {
							status.textContent = '密码错误';
							status.className = 'semantic-login-status is-error';
						}
					} catch {
						status.textContent = '网络错误，请重试';
						status.className = 'semantic-login-status is-error';
					} finally {
						submitButton.disabled = false;
						passwordInput.value = '';
					}
				});
			}

			window.addEventListener('DOMContentLoaded', () => {
				initSemanticLoginForm();
				initSemanticSearchWidget();
			});
		</script>
	</body>
</html>
