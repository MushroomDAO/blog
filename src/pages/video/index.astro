---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';

// 三条内容线。key 与 dailyVideo collection 的 category 枚举一一对应，
// 顺序就是页面上 tab 的顺序。
const CATEGORIES = [
	{
		key: 'Tech-Experiment',
		icon: '🔬',
		name: '技术实验',
		nameEn: 'Tech Experiments',
		blurb: '开源仓库开盒：挑一个真实仓库，装起来、跑起来、压到出问题为止，讲清楚它到底能不能用。',
	},
	{
		key: 'Problem-Thinking',
		icon: '🧠',
		name: '问题思考',
		nameEn: 'Problem Thinking',
		blurb: '以终为始：先把现实世界的痛点一个个列出来，再反向去找解法。解法会随 AI 迭代过时，痛点通常不会。',
		// 这条线的常驻入口：长期维护的痛点地图
		hub: { href: '/my/painpoints/', label: '🧠 痛点地图' },
	},
	{
		key: 'Public-Goods',
		icon: '🌱',
		name: '公共物品',
		nameEn: 'Public Goods',
		blurb: 'Digital Commons：一个视频讲一个我们自己做的开源组件，开源、免费、无许可，任何人都能直接拿去用。',
	},
] as const;

const all = (await getCollection('dailyVideo')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// 每条线：介绍文章置顶（isIntro），其余按时间倒序跟在后面
const grouped = CATEGORIES.map((cat) => {
	const items = all.filter((v) => v.data.category === cat.key);
	return {
		...cat,
		intro: items.find((v) => v.data.isIntro) ?? null,
		videos: items.filter((v) => !v.data.isIntro),
	};
});

const PAGE_TITLE = `🎬 Video | ${SITE_TITLE}`;
const PAGE_DESCRIPTION =
	'三条内容线：技术实验（开源仓库开盒实测）、问题思考（痛点分析，以终为始）、公共物品（开源组件介绍）。B 站 / YouTube 双平台同步更新，免费看。';
const PAGE_TITLE_EN = `🎬 Video | ${SITE_TITLE}`;
const PAGE_DESCRIPTION_EN =
	'Three content lines: tech experiments (open-source repo teardowns), problem thinking (pain-point analysis, working backwards), and public goods (our open-source components). Free on Bilibili and YouTube.';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead
			title={PAGE_TITLE}
			description={PAGE_DESCRIPTION}
			titleEn={PAGE_TITLE_EN}
			descriptionEn={PAGE_DESCRIPTION_EN}
		/>
		<style>
			main {
				width: 960px;
				max-width: calc(100% - 2em);
				margin: 0 auto;
				padding: 2em 1em;
			}
			.page-intro {
				margin-bottom: 1.5em;
			}
			.page-intro h1 {
				margin-bottom: 0.3em;
			}
			.page-intro p {
				color: rgb(var(--gray));
				margin: 0;
			}

			/* ── 分类 tab ───────────────────────────── */
			.tab-bar {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5em;
				margin-bottom: 2em;
				padding-bottom: 0.8em;
				border-bottom: 1px solid rgba(var(--gray), 0.25);
			}
			.tab-item {
				display: inline-flex;
				align-items: center;
				gap: 0.35em;
				padding: 0.45em 0.9em;
				border-radius: 999px;
				border: 1px solid rgba(var(--gray), 0.3);
				background: transparent;
				color: rgb(var(--gray-dark));
				font-size: 0.95em;
				text-decoration: none;
				cursor: pointer;
				transition: all 0.18s ease;
			}
			.tab-item:hover {
				border-color: var(--accent);
				color: var(--accent);
			}
			.tab-item.is-active {
				background: var(--accent);
				border-color: var(--accent);
				color: #fff;
				font-weight: 600;
			}

			/* ── 分类区块 ───────────────────────────── */
			.cat-section {
				margin-bottom: 3em;
			}
			.cat-header {
				margin-bottom: 1em;
			}
			.cat-header h2 {
				margin: 0 0 0.2em;
				font-size: 1.35em;
				color: rgb(var(--black));
			}
			.cat-header .cat-name-en {
				font-size: 0.75em;
				font-weight: 400;
				color: rgb(var(--gray));
				margin-left: 0.5em;
			}
			.cat-header p {
				margin: 0;
				color: rgb(var(--gray));
				font-size: 0.95em;
				line-height: 1.6;
			}
			.cat-hub {
				display: inline-block;
				margin-top: 0.6em;
				font-size: 0.9em;
				color: var(--accent);
				text-decoration: none;
				border-bottom: 1px solid transparent;
			}
			.cat-hub:hover {
				border-bottom-color: var(--accent);
			}

			/* ── 介绍卡（每个分类的门面：banner + 概述） ── */
			.intro-card {
				display: block;
				text-decoration: none;
				border: 1px solid rgba(var(--gray), 0.22);
				border-radius: 14px;
				overflow: hidden;
				background: rgb(var(--surface));
				transition: box-shadow 0.2s ease, transform 0.2s ease;
			}
			.intro-card:hover {
				box-shadow: 0 6px 20px rgba(var(--black), 8%);
				transform: translateY(-2px);
			}
			.intro-card img {
				width: 100%;
				height: 260px;
				object-fit: cover;
				display: block;
			}
			.intro-card-body {
				padding: 1em 1.2em 1.2em;
			}
			.intro-card-body h3 {
				margin: 0 0 0.4em;
				font-size: 1.1em;
				color: rgb(var(--black));
				line-height: 1.35;
			}
			.intro-card-body p {
				margin: 0;
				color: rgb(var(--gray));
				font-size: 0.92em;
				line-height: 1.65;
			}

			/* ── 该分类下的视频列表 ─────────────────── */
			ul {
				display: flex;
				flex-wrap: wrap;
				gap: 2rem;
				list-style-type: none;
				margin: 1.5em 0 0;
				padding: 0;
			}
			ul li {
				width: calc(50% - 1rem);
			}
			ul li * {
				text-decoration: none;
				transition: 0.2s ease;
			}
			ul li img {
				width: 100%;
				height: 200px;
				object-fit: cover;
				margin-bottom: 0.5rem;
				border-radius: 12px;
			}
			ul li a {
				display: block;
			}
			.title {
				margin: 0;
				color: rgb(var(--black));
				line-height: 1.2;
				font-size: 1.1rem;
			}
			.date {
				margin: 0;
				color: rgb(var(--gray));
				font-size: 0.9em;
			}
			.verdict-line {
				margin: 0.4em 0 0;
				font-size: 0.85em;
				color: rgb(var(--gray));
			}
			.empty-state {
				padding: 1.5em 0 0;
				color: rgb(var(--gray));
				font-size: 0.9em;
			}
			@media (max-width: 720px) {
				ul { gap: 0.5em; }
				ul li { width: 100%; text-align: center; }
				ul li img { height: 180px; }
				.intro-card img { height: 190px; }
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="page-intro">
				<h1>🎬 视频</h1>
				<p>三条内容线，B 站和 YouTube 双平台同步更新，全部免费。</p>
			</div>

			<!-- tab：默认「全部」，三个分类都展开；点某个 tab 只留那一块。
			     用 <a href="?cat=..."> 而不是纯 button，保证没 JS 时链接依然可分享、
			     也能被搜索引擎跟进；实际切换由下面的脚本在客户端拦截，不刷新页面。 -->
			<div class="tab-bar" id="tab-bar">
				<a href="/video/" class="tab-item is-active" data-tab="all">全部</a>
				{CATEGORIES.map((cat) => (
					<a href={`/video/?cat=${cat.key}`} class="tab-item" data-tab={cat.key} rel="nofollow">
						<span>{cat.icon}</span><span>{cat.name}</span>
					</a>
				))}
			</div>

			{grouped.map((cat) => (
				<section class="cat-section" data-cat={cat.key}>
					<div class="cat-header">
						<h2>
							{cat.icon} {cat.name}
							<span class="cat-name-en">{cat.nameEn}</span>
						</h2>
						<p>{cat.blurb}</p>
						{'hub' in cat && cat.hub && (
							<a class="cat-hub" href={cat.hub.href}>{cat.hub.label} →</a>
						)}
					</div>

					{cat.intro && (
						<a class="intro-card" href={`/video/${cat.intro.id}/`}>
							{cat.intro.data.coverImage && (
								<Image width={960} height={480} src={cat.intro.data.coverImage} alt="" />
							)}
							<div class="intro-card-body">
								<h3>{cat.intro.data.title}</h3>
								<p>{cat.intro.data.description}</p>
							</div>
						</a>
					)}

					{cat.videos.length > 0 ? (
						<ul>
							{cat.videos.map((video) => (
								<li>
									<a href={`/video/${video.id}/`}>
										{video.data.coverImage && (
											<Image width={720} height={360} src={video.data.coverImage} alt="" />
										)}
										<span class="date">
											<FormattedDate date={video.data.pubDate} />
										</span>
										<h4 class="title">{video.data.title}</h4>
										{video.data.verdict && <p class="verdict-line">💡 {video.data.verdict}</p>}
									</a>
								</li>
							))}
						</ul>
					) : (
						!cat.intro && <p class="empty-state">这条线的第一条视频还在路上。</p>
					)}
				</section>
			))}
		</main>
		<Footer />
		<script>
			// tab 切换：纯客户端显示/隐藏，不刷新页面，同时把选择同步进 URL，
			// 这样刷新或分享链接还能回到同一个 tab。
			const tabs = Array.from(document.querySelectorAll<HTMLAnchorElement>('.tab-item'));
			const sections = Array.from(document.querySelectorAll<HTMLElement>('.cat-section'));

			function applyTab(key: string, pushUrl: boolean) {
				const known = key !== 'all' && sections.some((s) => s.dataset.cat === key);
				const active = known ? key : 'all';
				for (const tab of tabs) {
					tab.classList.toggle('is-active', tab.dataset.tab === active);
				}
				for (const section of sections) {
					section.hidden = active !== 'all' && section.dataset.cat !== active;
				}
				if (pushUrl) {
					const url = active === 'all' ? '/video/' : `/video/?cat=${active}`;
					history.replaceState(null, '', url);
				}
			}

			for (const tab of tabs) {
				tab.addEventListener('click', (event) => {
					event.preventDefault();
					applyTab(tab.dataset.tab || 'all', true);
				});
			}

			// 进页面时读一次 ?cat=，让 /video/?cat=Public-Goods 这样的链接直接落到对应 tab
			applyTab(new URLSearchParams(location.search).get('cat') || 'all', false);
		</script>
	</body>
</html>
