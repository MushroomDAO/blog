---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';

// 三条内容线。key 与 dailyVideo collection 的 category 字段一一对应，
// 顺序就是页面上 tab 的顺序。
// 页面主体是视频本身——栏目介绍在这里只出一句话，详细的点进介绍文章看，
// 避免访客为了看到今天更新的视频要先翻过三大块介绍（二次点击问题）。
const CATEGORIES = [
	{
		key: 'Tech-Experiment',
		icon: '🔬',
		name: '技术实验',
		oneLiner: '开源仓库开盒，真机部署实测，给能不能用的结论。',
	},
	{
		key: 'Problem-Thinking',
		icon: '🧠',
		name: '问题思考',
		oneLiner: '以终为始，先讲透痛点本身，再反向找解法。',
		hub: { href: '/my/painpoints/', label: '痛点地图' },
	},
	{
		key: 'Public-Goods',
		icon: '🌱',
		name: '公共物品',
		oneLiner: 'MushroomDAO 出品的开源组件，免费、无许可、拿去就能用。',
	},
] as const;

const all = (await getCollection('dailyVideo')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// 介绍文章不进视频流——它是分类说明，走上面那行「详细介绍 →」的链接
const introBy = new Map(all.filter((v) => v.data.isIntro).map((v) => [v.data.category, v]));
const videos = all.filter((v) => !v.data.isIntro);

const catMeta = CATEGORIES.map((cat) => ({
	...cat,
	intro: introBy.get(cat.key) ?? null,
	count: videos.filter((v) => v.data.category === cat.key).length,
}));

const PAGE_TITLE = `🎬 Video | ${SITE_TITLE}`;
const PAGE_DESCRIPTION =
	'三条内容线：技术实验（开源仓库开盒实测）、问题思考（痛点分析，以终为始）、公共物品（MushroomDAO 出品的开源组件）。每条视频 B 站 / YouTube 同步更新，免费看。';
const PAGE_DESCRIPTION_EN =
	'Three content lines: tech experiments (open-source repo teardowns), problem thinking (pain-point analysis, working backwards), and public goods (open-source components by MushroomDAO). Every video ships to Bilibili and YouTube, always free.';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead
			title={PAGE_TITLE}
			description={PAGE_DESCRIPTION}
			titleEn={PAGE_TITLE}
			descriptionEn={PAGE_DESCRIPTION_EN}
		/>
		<style>
			main {
				width: 1040px;
				max-width: calc(100% - 2em);
				margin: 0 auto;
				padding: 1.5em 1em 2em;
			}

			/* ── 页头：压到最矮，把首屏留给视频 ────────── */
			.page-intro {
				display: flex;
				align-items: baseline;
				flex-wrap: wrap;
				gap: 0.6em;
				margin-bottom: 0.9em;
			}
			.page-intro h1 {
				margin: 0;
				font-size: 1.6em;
			}
			.page-intro span {
				color: rgb(var(--gray));
				font-size: 0.9em;
			}

			/* ── 分类 tab ───────────────────────────── */
			.tab-bar {
				display: flex;
				flex-wrap: wrap;
				gap: 0.45em;
				margin-bottom: 0.9em;
			}
			.tab-item {
				display: inline-flex;
				align-items: center;
				gap: 0.3em;
				padding: 0.35em 0.85em;
				border-radius: 999px;
				border: 1px solid rgba(var(--gray), 0.3);
				background: transparent;
				color: rgb(var(--gray-dark));
				font-size: 0.9em;
				text-decoration: none;
				cursor: pointer;
				transition: all 0.18s ease;
			}
			.tab-item:hover {
				border-color: var(--accent);
				color: var(--accent);
			}
			.tab-item.is-active {
				background: var(--accent);
				border-color: var(--accent);
				color: #fff;
				font-weight: 600;
			}
			.tab-count {
				font-size: 0.85em;
				opacity: 0.7;
			}

			/* ── 栏目一句话说明：紧凑，不抢视频的位置 ──── */
			.cat-notes {
				margin: 0 0 1.4em;
				padding: 0.7em 0.9em;
				border-left: 3px solid var(--accent);
				background: rgba(var(--gray), 0.06);
				border-radius: 0 8px 8px 0;
			}
			.cat-note {
				display: flex;
				flex-wrap: wrap;
				align-items: baseline;
				gap: 0.4em;
				font-size: 0.88em;
				line-height: 1.9;
				color: rgb(var(--gray));
			}
			.cat-note strong {
				color: rgb(var(--black));
				font-weight: 600;
			}
			.cat-note a {
				color: var(--accent);
				text-decoration: none;
				white-space: nowrap;
			}
			.cat-note a:hover {
				text-decoration: underline;
			}
			.note-sep {
				color: rgba(var(--gray), 0.5);
			}

			/* ── 视频网格：首屏主角 ─────────────────── */
			.video-grid {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 1.5rem 1.4rem;
				list-style: none;
				margin: 0;
				padding: 0;
			}
			.video-grid li {
				display: flex;
				flex-direction: column;
			}
			.video-card {
				display: block;
				text-decoration: none;
			}
			.thumb-wrap {
				position: relative;
				border-radius: 10px;
				overflow: hidden;
				background: rgba(var(--gray), 0.12);
				aspect-ratio: 16 / 9;
			}
			.thumb-wrap img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				display: block;
				transition: transform 0.25s ease;
			}
			.video-card:hover .thumb-wrap img {
				transform: scale(1.03);
			}
			.thumb-badge {
				position: absolute;
				left: 0.5em;
				top: 0.5em;
				padding: 0.15em 0.5em;
				border-radius: 999px;
				background: rgba(0, 0, 0, 0.62);
				color: #fff;
				font-size: 0.72em;
				backdrop-filter: blur(2px);
			}
			.video-card h3 {
				margin: 0.55em 0 0.25em;
				font-size: 1em;
				line-height: 1.35;
				color: rgb(var(--black));
			}
			.video-meta {
				display: flex;
				align-items: center;
				gap: 0.5em;
				font-size: 0.82em;
				color: rgb(var(--gray));
			}
			.video-verdict {
				margin: 0.35em 0 0;
				font-size: 0.85em;
				line-height: 1.55;
				color: rgb(var(--gray));
			}
			/* 直达平台：想绕开本站直接看的人不用多点一次 */
			.platform-links {
				display: flex;
				gap: 0.7em;
				margin-top: 0.45em;
				font-size: 0.8em;
			}
			.platform-links a {
				color: rgb(var(--gray));
				text-decoration: none;
				border-bottom: 1px solid transparent;
			}
			.platform-links a:hover {
				color: var(--accent);
				border-bottom-color: var(--accent);
			}

			/* ── 空态 ──────────────────────────────── */
			.empty-state {
				padding: 2.5em 1em;
				text-align: center;
				border: 1px dashed rgba(var(--gray), 0.35);
				border-radius: 12px;
				color: rgb(var(--gray));
			}
			.empty-state p {
				margin: 0 0 0.5em;
			}
			.empty-state a {
				color: var(--accent);
				text-decoration: none;
			}
			.empty-state a:hover {
				text-decoration: underline;
			}

			@media (max-width: 900px) {
				.video-grid { grid-template-columns: repeat(2, 1fr); }
			}
			@media (max-width: 600px) {
				.video-grid { grid-template-columns: 1fr; gap: 1.3rem; }
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="page-intro">
				<h1>🎬 视频</h1>
				<span>B 站 / YouTube 同步更新，全部免费</span>
			</div>

			<!-- tab：默认「全部」。写成 <a href="?cat=..."> 而不是纯 button，
			     没 JS 时链接仍可分享、可被搜索引擎跟进；实际切换由下面的脚本
			     在客户端拦截，不刷新页面。 -->
			<div class="tab-bar">
				<a href="/video/" class="tab-item is-active" data-tab="all">
					全部<span class="tab-count">{videos.length}</span>
				</a>
				{catMeta.map((cat) => (
					<a href={`/video/?cat=${cat.key}`} class="tab-item" data-tab={cat.key} rel="nofollow">
						<span>{cat.icon}</span><span>{cat.name}</span>
						<span class="tab-count">{cat.count}</span>
					</a>
				))}
			</div>

			<!-- 栏目说明：一句话就够，详细的点进介绍文章看 -->
			<div class="cat-notes">
				{catMeta.map((cat) => (
					<div class="cat-note" data-note={cat.key}>
						<strong>{cat.icon} {cat.name}</strong>
						<span>{cat.oneLiner}</span>
						{'hub' in cat && cat.hub && (
							<>
								<a href={cat.hub.href}>{cat.hub.label} →</a>
								<span class="note-sep">·</span>
							</>
						)}
						{cat.intro && <a href={`/video/${cat.intro.id}/`}>详细介绍 →</a>}
					</div>
				))}
			</div>

			{videos.length === 0 ? (
				<div class="empty-state">
					<p>第一条视频还在路上。</p>
					<p>
						想知道这三条线各自要做什么，先看
						{catMeta.filter((c) => c.intro).map((c, i) => (
							<>
								{i > 0 && <span class="note-sep"> · </span>}
								<a href={`/video/${c.intro!.id}/`}>{c.icon} {c.name}</a>
							</>
						))}
						的介绍。
					</p>
				</div>
			) : (
				<ul class="video-grid">
					{videos.map((video) => {
						const meta = CATEGORIES.find((c) => c.key === video.data.category);
						return (
							<li data-cat={video.data.category}>
								<a class="video-card" href={`/video/${video.id}/`}>
									<div class="thumb-wrap">
										{video.data.coverImage && (
											<Image width={640} height={360} src={video.data.coverImage} alt="" />
										)}
										{meta && <span class="thumb-badge">{meta.icon} {meta.name}</span>}
									</div>
									<h3>{video.data.title}</h3>
									<div class="video-meta">
										<FormattedDate date={video.data.pubDate} />
									</div>
									{video.data.verdict && <p class="video-verdict">💡 {video.data.verdict}</p>}
								</a>
								{(video.data.bilibiliUrl || video.data.youtubeUrl) && (
									<div class="platform-links">
										{video.data.bilibiliUrl && (
											<a href={video.data.bilibiliUrl} target="_blank" rel="noopener" title="Watch on Bilibili">📺 B 站</a>
										)}
										{video.data.youtubeUrl && (
											<a href={video.data.youtubeUrl} target="_blank" rel="noopener" title="Watch on YouTube">▶️ YouTube</a>
										)}
									</div>
								)}
							</li>
						);
					})}
				</ul>
			)}
		</main>
		<Footer />
		<script>
			// tab 切换：纯客户端显示/隐藏，不刷新页面，同时把选择同步进 URL，
			// 这样刷新或分享链接还能回到同一个 tab。
			const tabs = Array.from(document.querySelectorAll<HTMLAnchorElement>('.tab-item'));
			const cards = Array.from(document.querySelectorAll<HTMLElement>('.video-grid li'));
			const notes = Array.from(document.querySelectorAll<HTMLElement>('.cat-note'));
			const knownKeys = new Set(notes.map((n) => n.dataset.note));

			function applyTab(key: string, pushUrl: boolean) {
				const active = knownKeys.has(key) ? key : 'all';
				for (const tab of tabs) {
					tab.classList.toggle('is-active', tab.dataset.tab === active);
				}
				// 选了某条线就只留那条线的说明，不然三行说明会一直压着视频
				for (const note of notes) {
					note.hidden = active !== 'all' && note.dataset.note !== active;
				}
				for (const card of cards) {
					card.hidden = active !== 'all' && card.dataset.cat !== active;
				}
				if (pushUrl) {
					history.replaceState(null, '', active === 'all' ? '/video/' : `/video/?cat=${active}`);
				}
			}

			for (const tab of tabs) {
				tab.addEventListener('click', (event) => {
					event.preventDefault();
					applyTab(tab.dataset.tab || 'all', true);
				});
			}

			// 进页面时读一次 ?cat=，让 /video/?cat=Public-Goods 这样的链接直接落到对应 tab
			applyTab(new URLSearchParams(location.search).get('cat') || 'all', false);
		</script>
	</body>
</html>
