from pathlib import Path
from PIL import Image,ImageChops
import hashlib,json
for i in range(1,4):
    src=Path('generated_images/moss-image-20261108')/f'fig-{i:02d}-raw.png'
    out=Path('src/assets/images')/f'moss-image-openmoss-layout-generation-review-fig-{i:02d}.png'
    with Image.open(src) as im:
        rgb=im.convert('RGB').resize((1120,630),Image.Resampling.LANCZOS)
    r,g,b=rgb.split();lo=ImageChops.darker(ImageChops.darker(r,g),b);hi=ImageChops.lighter(ImageChops.lighter(r,g),b)
    mask=ImageChops.multiply(lo.point(lambda v:255 if v>=248 else 0),ImageChops.subtract(hi,lo).point(lambda v:255 if v<=12 else 0))
    clean=Image.composite(Image.new('RGB',rgb.size,'white'),rgb,mask)
    adaptive=clean.quantize(colors=48,method=Image.Quantize.FASTOCTREE,dither=Image.Dither.NONE)
    learned=adaptive.getpalette()
    frequent=sorted(adaptive.getcolors(256),reverse=True)[:43]
    colors=[tuple(learned[3*idx:3*idx+3]) for _,idx in frequent]
    colors += [(255,128,0),(0,110,255),(240,40,35),(255,248,225),(255,255,255)]
    assert len(colors)==48
    palette=Image.new('P',(1,1));palette.putpalette([v for color in colors for v in color])
    final=clean.quantize(palette=palette,dither=Image.Dither.NONE)
    final.save(out,format='PNG',optimize=True,compress_level=9)
    with Image.open(out) as check:
        check.load()
        assert check.size==(1120,630) and check.mode=='P'
        assert len(check.getpalette())//3<=48
        assert len(check.getcolors(256))<=48 and out.stat().st_size<90000
        assert check.tobytes()==final.tobytes() and check.getpalette()==final.getpalette()
        print(json.dumps({'file':str(out),'bytes':out.stat().st_size,'colors':len(check.getcolors(256)),'palette_entries':len(check.getpalette())//3,'dimensions':check.size,'dither':'NONE','sha256':hashlib.sha256(out.read_bytes()).hexdigest()}))
