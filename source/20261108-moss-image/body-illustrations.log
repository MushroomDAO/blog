    neutral=ImageChops.subtract(hi,lo).point(lambda v:255 if v<=12 else 0)
    nearwhite=lo.point(lambda v:255 if v>=248 else 0)
    mask=ImageChops.multiply(neutral,nearwhite)
    clean=Image.composite(Image.new('RGB',rgb.size,'white'),rgb,mask)
    q=clean.quantize(colors=48,method=Image.Quantize.MEDIANCUT,dither=Image.Dither.NONE)
    q.save(out,format='PNG',compress_level=9,optimize=True)
    with Image.open(out) as im:
        im.load()
        assert im.size==(1120,630)
        assert im.mode=='P'
        assert len(im.getcolors(256))<=48
        assert out.stat().st_size<90000
        assert im.tobytes()==q.tobytes(), 'Final copy changed palette indices'
        assert im.getpalette()==q.getpalette(), 'Final copy changed palette'
        assert all(im.convert('RGB').getpixel(p)==(255,255,255) for p in [(0,0),(1119,0),(0,629),(1119,629)])
        print(json.dumps({'file':str(out),'bytes':out.stat().st_size,'size':im.size,'colors':len(im.getcolors(256)),'palette_entries':len(im.getpalette())//3,'dither':'NONE','white_corners':True,'sha256':hashlib.sha256(out.read_bytes()).hexdigest()}))
