# Amber Heart 服务器配置。
# 推荐运行 ./install.sh 自动生成 .env。嵌入、第一级精排和对话分别填写。
# 手动配置时复制为 .env（chmod 600），替换所有尖括号占位符。.env 含密钥，不要提交到任何仓库。

# ── 由 install.sh 生成，安装后不要改 ────────────────────────────────
MEMORY_DB_ADMIN_PASSWORD=<随机密码>
MEMORY_DB_OWNER_PASSWORD=<随机密码>
MEMORY_DB_APP_PASSWORD=<随机密码>
# 访问钥匙的加密主密钥。丢失后所有空间钥匙都要重新生成，请和数据库一起备份。
MEMORY_ACCESS_KEY_MASTER_KEY=<Fernet 主密钥>
# 嵌入维度随模型而定。Gemini Embedding 2 推荐 1536，bge-m3 用 1024。已有库升级保留原维度。
MEMORY_EMBEDDING_DIMENSIONS=1536
MEMORY_TIMEZONE=Asia/Shanghai
MEMORY_DAY_START_HOUR=3

# ── 访问地址 ────────────────────────────────────────────────────────
# 你的域名（不带 https://）和完整网址。
MEMORY_DOMAIN=<memory.example.com>
MEMORY_WEB_ORIGIN=<https://memory.example.com>
# 填 caddy 时启动内置 Caddy 自动申请 HTTPS 证书；自备 nginx 等反代时留空，并反代到 127.0.0.1:18081。
COMPOSE_PROFILES=caddy
MEMORY_LOCAL_PORT=18081

# ── 内存上限（防止拖垮同机其他服务，不是存储限额）──────────────────
# 1 GB 服务器：512m / 256m；2 GB：768m / 256m；4 GB：1024m / 512m。
MEMORY_APP_MEM_LIMIT=512m
MEMORY_DB_MEM_LIMIT=256m

# ── 模型 ────────────────────────────────────────────────────────────
# 1. 嵌入。更换模型需要重算已有向量。
# Google 官方基址用 https://generativelanguage.googleapis.com/v1beta/openai，模型用 gemini-embedding-2。
MEMORY_EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
MEMORY_EMBEDDING_API_KEY=<嵌入 key>
MEMORY_EMBEDDING_MODEL=google/gemini-embedding-2

# 2. 第一级精排可选。启用时取消下面四行的注释，并填写地址、key、模型与格式。
# 硅基流动示例用 https://api.siliconflow.cn/v1、硅基流动 key（可与嵌入共用）、BAAI/bge-reranker-v2-m3、cohere。
# Voyage 示例用 https://api.voyageai.com/v1、Voyage key、rerank-3、voyage。
# OpenRouter 示例用 https://openrouter.ai/api/v1、OpenRouter key、mongodb/rerank-3、cohere。
# MEMORY_DOCUMENT_RERANK_BASE_URL=https://api.voyageai.com/v1
# MEMORY_DOCUMENT_RERANK_API_KEY=
# MEMORY_DOCUMENT_RERANK_MODEL=rerank-3
# MEMORY_DOCUMENT_RERANK_FORMAT=voyage

# 3. 对话。后台岗位的地址和 key 留空时复用此上游。
MEMORY_UPSTREAM_BASE_URL=https://openrouter.ai/api/v1
MEMORY_UPSTREAM_API_KEY=<对话 key>
MEMORY_KEYWORD_MODEL=deepseek/deepseek-v4-flash
MEMORY_FINAL_RERANK_MODEL=deepseek/deepseek-v4-flash
MEMORY_SUMMARY_MODEL=deepseek/deepseek-v4-pro
MEMORY_SUMMARY_BACKUP_MODEL=deepseek/deepseek-v4-flash
MEMORY_DIARY_MODEL=deepseek/deepseek-v4-pro
MEMORY_DIARY_BACKUP_MODEL=deepseek/deepseek-v4-flash
MEMORY_EXTRACTION_MODEL=deepseek/deepseek-v4-pro
MEMORY_TOPIC_SUMMARY_MODEL=deepseek/deepseek-v4-pro
MEMORY_RECENT_NOTES_TIDY_MODEL=deepseek/deepseek-v4-pro
# 回执补判：每晚判断聊天里用到了哪些记忆，让很少主动报告的模型下归档也能正常工作。
MEMORY_RECEIPT_JUDGE_MODEL=deepseek/deepseek-v4-flash

# 图片描述（可选）：把聊天里的图片转成文字记住，需要能看图的模型，留空则不描述。
MEMORY_IMAGE_DESCRIPTION_MODEL=
MEMORY_IMAGE_DESCRIPTION_BACKUP_MODEL=

# 以上每个岗位都可以单独走别的平台：成对添加 MEMORY_<岗位>_BASE_URL 和 MEMORY_<岗位>_API_KEY，
# 岗位名如 SUMMARY、DIARY、EXTRACTION、TOPIC_SUMMARY、RECEIPT_JUDGE、RECENT_NOTES_TIDY、IMAGE_DESCRIPTION、KEYWORD、FINAL_RERANK。

# ── 高级（一般不用改）─────────────────────────────────────────────
# 国内服务器构建镜像时下载 Python 依赖很慢的话，填一个国内软件源，例如腾讯云 https://mirrors.cloud.tencent.com/pypi/simple
PIP_INDEX_URL=

MEMORY_SUMMARY_TIMEOUT_SECONDS=120
MEMORY_DIARY_TIMEOUT_SECONDS=300
MEMORY_EXTRACTION_TIMEOUT_SECONDS=600
MEMORY_IMPORT_CONCURRENCY=3
MEMORY_TOPIC_SUMMARY_TIMEOUT_SECONDS=300
MEMORY_RECEIPT_JUDGE_TIMEOUT_SECONDS=120
MEMORY_RECENT_NOTES_TIDY_TIMEOUT_SECONDS=300
MEMORY_RECENT_NOTES_SOFT_LIMIT=3500
MEMORY_RECENT_NOTES_TARGET=3000

# 新卡片进入待审核后，经过这些小时（按业务日计）在每日任务里自动收录；管理页可关闭自动收录。
MEMORY_AUTO_APPROVE_AFTER_HOURS=48

# 卡片多久没被用到就归档（天）。归档后仍可在管理页查看和恢复。
MEMORY_ARCHIVE_RULE_DAYS=365
MEMORY_ARCHIVE_REFLECTION_DAYS=180
MEMORY_ARCHIVE_KNOWLEDGE_DAYS=180
MEMORY_ARCHIVE_EVENT_DAYS=120
MEMORY_ARCHIVE_EMOTIONAL_DAYS=365
# 回执保护：最近窗口内使用回执不足时暂停归档，避免误归档。
MEMORY_ARCHIVE_RECEIPT_WINDOW_DAYS=14
MEMORY_ARCHIVE_RECEIPT_MIN_SAMPLES=20
MEMORY_ARCHIVE_RECEIPT_MIN_RATE=0.8

# 主题总结每次纳入的卡片数量范围。
MEMORY_TOPIC_SUMMARY_MIN_CARDS=5
MEMORY_TOPIC_SUMMARY_MAX_CARDS=30

# 图片描述的并发与上限。
MEMORY_IMAGE_DESCRIPTION_TIMEOUT_SECONDS=30
MEMORY_IMAGE_DESCRIPTION_CONCURRENCY=2
MEMORY_IMAGE_DESCRIPTION_MAX_PENDING=4
MEMORY_IMAGE_DESCRIPTION_MAX_IMAGES=32
